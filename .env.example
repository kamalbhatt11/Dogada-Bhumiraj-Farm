# Copy values into your hosting provider's environment settings.
APP_ENV=production
SECRET_KEY=GENERATE_A_UNIQUE_RANDOM_64_HEX_CHARACTER_VALUE
INITIAL_OWNER_PASSWORD=SET_A_UNIQUE_PASSWORD_AT_LEAST_12_CHARACTERS
DATABASE_URL=YOUR_PERSISTENT_POSTGRESQL_CONNECTION_STRING
SITE_URL=https://your-domain.example
SESSION_COOKIE_SECURE=true

# Optional: set only for a one-time owner password reset, then remove it.
# RESET_OWNER_PASSWORD=SET_A_UNIQUE_PASSWORD_AT_LEAST_12_CHARACTERS
